{
  "manifest_version": 3,
  "name": "NovaMotion Live Tab",
  "short_name": "NovaMotion",
  "version": "2.2.5",
  "description": "NovaMotion Live Tab — local live wallpapers, smart notes, calendars, shortcuts, focus tools and live customization.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "NovaMotion Live Tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
